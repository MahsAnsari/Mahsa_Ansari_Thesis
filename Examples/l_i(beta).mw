<Group hide-input="false" labelreference="L146" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">p:=nextprime(2^30);
M:=[z^2-5,w^2-3];
F1:=97*w^9*z - 56*w*x^5*y^2*z + 87*x^5*y^5 ; <Font foreground="[0,128,128]">#cofactor of f1</Font>
F2:=-17*w*x^4*y^3 + 4*w^4*x*y*z - 82*w*x^4*z + 62;  <Font foreground="[0,128,128]">#cofactor of f2</Font>
f1:=rpoly(F1*(w+z*x*y),[x,y,w,z],M);
f2:=rpoly((w+z*x*y)*F2,[x,y,w,z],M);</Text-field>
</Input>
