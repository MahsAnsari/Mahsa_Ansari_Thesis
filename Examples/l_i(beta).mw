<Group labelreference="L18" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field style="Text" layout="Normal">Subrec takes two polynomials f1,f2 in Q(alpha)[x] and returns their resultant in Q(alpha), the p.r.s. 
I does not work when deg(f)=deg(g)</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L6" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"></Text-field>
</Input>
</Group><CodeEditor-ExecGroup view="presentation" labelreference="L149" drawlabel="true" applyint="true" applyrational="true" display="code"><EC-CodeEditor id="CodeEditRegion1" expanded="true" visible="true" pixel-width="500" pixel-height="200" code-language="text/maple" autofit="true" wrapping="true" show-border="true" code-line-numbers="true">Subrec:=proc(f,g)
local n,m,j,S,R,r,Re,Ring,M,X,E,F,NR,G,d,i;
i:=2;
m:=degrpoly(f);
n:=degrpoly(g);
Ring:=getring(f);
M,X,E := op(Ring);
NR := [M,X[2..-1],E]; #removing one variable from the list of variables
if g=rpoly(0,Ring) then return(&quot;Division by zero&quot;) fi;
#if m&gt;n then j:=m-1 else j:=n; fi;
j:=m-1; 
S[1],S[2]:=f,g; 
Re:=[f,g]; #Re contains all the subresultants algorithm's remainders
R:=rpoly(1,NR);
#MEA contains all the MEA remainders.I construct the remainders of the Monic Euclidean Algorithms from the remainders of Subresultant algorithm.
r:=degrpoly(g);
while r&gt;0  do
   r:=degrpoly(S[i]);
   if r=0 or type(r, `*`) then return(rpoly(rpoly(S[i]),NR),Re); fi;
   S[i+1]:=mulrpoly(invrpoly(powrpoly(negrpoly(R),j-r+2)),premrpoly(S[i-1],S[i]));
   if j&lt;&gt;r then S[i]:=mulrpoly(invrpoly(powrpoly(R,j-r)),powrpoly(lcrpoly(S[i]),j-r),S[i]); printf(&quot;S=%a\134n&quot;,rpoly(S[i])); fi;

   Re:=[op(Re),S[i+1]];
   j:=r-1;
   R:=lcrpoly(S[i]);

i:=i+1; 
od;
end:
</EC-CodeEditor></CodeEditor-ExecGroup>
