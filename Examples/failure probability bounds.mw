<Group hide-input="false" labelreference="L21" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"><Font opaque="true" size="14" background="[255,255,153]" foreground="[0,0,255]">#Zero-divisor pairs</Font>
#In Theorem 9, we have maxnorm(M(z))&lt;BM
d:=4; <Font foreground="[0,128,128]">#degree of thefield</Font>
g:=z+3*w; <Font foreground="[0,128,128]">#gamma</Font>
gam:=expand(g^d);  <Font foreground="[0,128,128]">#gamma^d</Font>
mg:=maxnorm(gam);
C:=ceil(evalf(log[2](mg)));  <Font foreground="[0,128,128]">#maxnorm(gamma^d)&lt;2^C</Font>
n,m:=degrpoly(f1,x),degrpoly(f2,y);
pr1:=(l[1]+dd[1]*maxnorm(M1))^(sigma[1]):
pr2:=(l[2]+dd[2]*maxnorm(M2))^(sigma[2]):
BM:=d^(d/2)*(2^C*pr1*pr2)^(d);
DD:=max(degrpoly(f1,x),degrpoly(f2,x),degrpoly(f1,y),degrpoly(f2,y));
H:=max(maxnorm(rpoly(f1)),maxnorm(rpoly(f2)));
p:=nextprime(2^30);
Bl:=p^(2*DD^2)*(2*DD(DD+1))^(2*k-2)*H^(2*DD);
</Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" spaceabove="0" linebreak="space" rightmargin="0" linespacing="0.0" initial="0" firstindent="0" leftmargin="0" bulletsuffix="" alignment="left" bullet="none" spacebelow="0" pagebreak-before="false">L:=d*Bl^2+(2*DD)*(d-1)*BM^2:
num:=floor((d*(2*DD+1)/2)*log[2](L));
den:=30*np;
B:=evalf(num/den);
PGCDAZ:=3*k*(DD+1)^(k-1)*B;
</Text-field>
</Input>
