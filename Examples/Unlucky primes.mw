<Group hide-input="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"><Font opaque="true" size="14" background="[255,255,153]" foreground="[0,0,255]">#Unlucky Primes</Font><Font foreground="[0,0,255]">
#Example 1
restart;
</Font><Font foreground="[128,0,0]">p:=7;
h1 := z*x1^2 + 2*x2*x1 + 7*z*(x2 - 3)+x2;
h2 := z*x1^2 + 14*x2*x1;
lcoeff(h1,x2);
lcoeff(h1 mod p,x2);
g:=x1+z*x2;
f1:=expand(h1*g);
f2:=expand(h2</Font>*g);
read &quot;recden&quot;;
RDP:=Algebraic:-RecursiveDensePolynomials;</Text-field>
</Input>
