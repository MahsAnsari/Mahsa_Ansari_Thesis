<Group labelreference="L18" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field style="Text" layout="Normal">Subrec takes two polynomials f1,f2 in Q(alpha)[x] and returns their resultant in Q(alpha), the p.r.s. 
I does not work when deg(f)=deg(g)</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L6" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">Subrec:=proc(f,g)
local n,m,j,S,R,r,Re,Ring,M,X,E,F,NR,G,d,i;<Font foreground="[0,0,255]">
i:=2;</Font>
m:=degrpoly(f);
n:=degrpoly(g);
Ring:=getring(f);
M,X,E := op(Ring);
NR := [M,X[2..-1],E]; <Font foreground="[0,128,128]">#removing one variable from the list of variables
</Font>if g=rpoly(0,Ring) then return(&quot;Division by zero&quot;) fi;
#if m&gt;n then j:=m-1 else j:=n; fi;
j:=m-1; 
S[1],S[2]:=f,g; 
Re:=[f,g]; <Font foreground="[0,128,128]">#Re contains all the subresultants algorithm's remainders</Font>
R:=rpoly(1,NR);
<Font foreground="[0,128,128]">#MEA contains all the MEA remainders.I construct the remainders of the Monic Euclidean Algorithms from the remainders of Subresultant algorithm.
</Font>r:=degrpoly(g);
while r&gt;0 do
   if S[i]=0 then return (rpoly(rpoly(S[i]),NR),Re); fi;
   r:=degrpoly(S[i]);
   if r=0 then return(rpoly(rpoly(S[i]),NR),Re); fi;
   S[i+1]:=mulrpoly(invrpoly(powrpoly(negrpoly(R),j-r+2)),premrpoly(S[i-1],S[i]));
  
<Font encoding="UTF-8">if j&lt;&gt;r then S[i]:=mulrpoly(invrpoly(powrpoly(R,j-r)),powrpoly(lcrpoly(S[i]),j-r),S[i]); printf(&quot;S=%a\134n&quot;,rpoly(S[i])); fi;</Font>

   Re:=[op(Re),S[i+1]];<Font foreground="[0,0,255]">
</Font>   j:=r-1;
   R:=lcrpoly(S[i]);

i:=i+1; 
od;
end:</Text-field>
</Input>
</Group><CodeEditor-ExecGroup view="presentation" labelreference="L56" drawlabel="true" applyint="true" applyrational="true" display="code"><EC-CodeEditor id="CodeEditRegion0" expanded="false" visible="true" pixel-width="500" pixel-height="200" code-language="text/maple" autofit="true" wrapping="true" show-border="true" code-line-numbers="true">#MEA and EA
MEA:=proc(A, B) #Monic Euclidean Algorithm
local q,r,s,t,k,n,m,h,R,Ring,c,re,a,b;

if degrpoly(B)&gt;degrpoly(A) then a,b:=B,A; else a,b:=A,B; fi;
c:=0;
r[0]:=a;
r[1]:=b;
m[0]:=r[0];
k:=1;
re:=[];
R:=[a];
Ring:=getring(a);
while r[k]&lt;&gt;rpoly(0,Ring) do
   if r[k]=rpoly(0,Ring) then printf(&quot;Remainder is zero&quot;); fi;
   R:=[op(R),r[k]];  #List of the remainders
   re:=[op(re),lcrpoly(r[k])]; #Leading coefficients of the remaindes
   m[k]:=monic(r[k]);
   r[k+1]:=remrpoly(m[k-1],m[k]);
   k:=k+1;
   n:=k-1;
   c:=c+1;
od;
return (m[n],n,re,R);
end:


EA:=proc(A, B) #Euclidean Algorithm
local q,r,s,t,k,n,m,h,R,c,re,Ring,a,b;
if degrpoly(B)&gt;degrpoly(A) then a,b:=B,A; else a,b:=A,B; fi;
c:=0;
c:=0;
r[0]:=a;
r[1]:=b;
#m[0]:=r[0];
k:=1;
re:=[];
Ring:=getring(a);
R:=[a];
while r[k]&lt;&gt;rpoly(0,Ring) do
   R:=[op(R),r[k]];   #List of remainders
   re:=[op(re),lcrpoly(r[k])]; #Leading coefficients of the remaindes
   r[k+1]:=remrpoly(r[k-1],r[k]);
   k:=k+1;
   n:=k-1;
   c:=c+1;
od;
return (r[n],n,re,R);
end:
</EC-CodeEditor></CodeEditor-ExecGroup>
