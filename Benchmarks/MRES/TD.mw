<Group hide-input="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">t:=80:
k:=1:
T := [seq(0, j = 1 .. t/2)]:
for i from 2 by 2 to t do
    f1 := RDP:-rpoly(x^i*y^i + randpoly(XT, degree = i), XT, M);
    f2 := RDP:-rpoly(x^i*y^i + randpoly(XT, degree = i), XT, M);
   <Font encoding="UTF-8">printf(&quot;dF=%d  deg(f1,x)=%d  deg(f1,y)=%d  deg(f2,x)=%d  deg(f2,y)=%d \134n&quot;,
</Font>     dF,RDP:-degrpoly(f1,x),RDP:-degrpoly(f1,y),RDP:-degrpoly(f2,x),RDP:-degrpoly(f2,y));
  try;
  t:=time():
  R1:=timelimit(1000,MRS1(f1,f2,x));
  printf(&quot;dR1=%d<Font encoding="UTF-8">\134n&quot;</Font>,RDP:-degrpoly(R1,y));
  tMRS1:=time()-t;
  tt:=time():
catch &quot;time expired&quot;: 
        tMRS1:= FAIL; 
end try;
try 
   R2 := timelimit(1000, MRS2(f1, f2, x)); 
   tMRS2 := time() - tt; 
   printf(&quot;dR2=%d<Font encoding="UTF-8">\134n&quot;</Font>,RDP:-degrpoly(R2,y));
catch &quot;time expired&quot;: 
tMRS2 := FAIL; 
end try;
if tMRS2 &lt;&gt; FAIL and tMGCD1 &lt;&gt; FAIL then
<Font encoding="UTF-8">    printf(&quot;Check=%a\134n&quot;, evalb(R1 = R2));
</Font>    T[k] := tMRS2/tMRS1;
else
    T[k] := &quot;F&quot;;
end if;
k := k + 1;
od:

</Text-field>
</Input>
