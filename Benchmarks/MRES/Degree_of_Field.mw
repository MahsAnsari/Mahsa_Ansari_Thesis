<Group hide-input="false" labelreference="L233" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">for i in dF do
   M:=Minpolylist(i, num); #List of minimal polynomials. It creats the max number of minimal polynomials
   Xmin:=ListTools:-Reverse([seq(z[j],j=1..nops(M))]);
   XT:=[op(Xpoly),op(Xmin)];
   f1:=RDP:-rpoly(x^d*y^d+randpoly(XT,degree=d),XT,M);
   f2:=RDP:-rpoly(x^d*y^d+randpoly(XT,degree=d),XT,M);
  <Font encoding="UTF-8">printf(&quot;dF=%d  deg(f1,x)=%d  deg(f1,y)=%d  deg(f2,x)=%d  deg(f2,y)=%d \134n&quot;,
</Font>     i,RDP:-degrpoly(f1,x),RDP:-degrpoly(f1,y),RDP:-degrpoly(f2,x),RDP:-degrpoly(f2,y));
  try;
  t:=time():
